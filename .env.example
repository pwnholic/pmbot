# Polymarket Bot - Environment Variables
# Copy this file to .env and fill in your values.

# REQUIRED for live trading:
# Your Polygon wallet private key (hex, with or without 0x prefix).
# This wallet must have USDC on Polygon and approved the Polymarket exchange contract.
PMBOT_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# OPTIONAL: Override log level (default: info)
# RUST_LOG=pmbot=debug,pmbot_market=debug,pmbot_executor=debug
